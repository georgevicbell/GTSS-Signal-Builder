{
  "name": "gtss",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/public.d.ts",
      "import": "./dist/schema/public.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild index.ts schema/public.ts --bundle --format=esm --platform=browser --packages=external --outdir=dist && tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "nanoid": "^5.1.5",
    "zod": "^3.24.2",
    "zustand": "^5.0.6"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
